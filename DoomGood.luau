    -- 1. Check if the engine is looking for the WAD
    if path:lower():find("doom.wad") or path:lower():find("doom1.wad") then
        local id = nextFileId
        openFiles[id] = { name = path, pos = 0, type = "WAD" }
        nextFileId += 1
